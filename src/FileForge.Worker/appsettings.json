{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ImageMagick": {
    "Timeout": "00:00:30",
    "Sandbox": {
      "Enabled": true,
      "Image": "fileforge-imagemagick:1",
      "MemoryLimit": "768m",
      "CpuLimit": "1",
      "PidsLimit": 64,
      "TmpSize": "256m"
    }
  },
  "Cleanup": {
    "Interval": "00:05:00",
    "BatchSize": 200,
    "OrphanFileMinAge": "01:00:00",
    "StuckJobTimeout": "00:10:00",
    "MaxAttempts": 3
  }
}
