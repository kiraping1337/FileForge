{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Sandbox": {
    "PidsLimit": 64,
    "TmpSize": "256m"
  },
  "ImageMagick": {
    "Image": "fileforge-imagemagick:1",
    "MemoryLimit": "768m",
    "CpuLimit": "1",
    "Timeout": "00:00:30"
  },
  "Ffmpeg": {
    "Image": "fileforge-ffmpeg:1",
    "MemoryLimit": "1g",
    "CpuLimit": "2",
    "Timeout": "00:15:00",
    "Threads": 2,
    "MaxOutputBytes": 1073741824
  },
  "Cleanup": {
    "Interval": "00:05:00",
    "BatchSize": 200,
    "OrphanFileMinAge": "01:00:00",
    "StuckJobTimeout": "01:00:00",
    "MaxAttempts": 3
  }
}
