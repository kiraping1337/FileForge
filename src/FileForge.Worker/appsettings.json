{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ImageMagick": {
    "ExecutablePath": "magick",
    "Timeout": "00:00:30"
  },
  "Cleanup": {
    "Interval": "00:05:00",
    "BatchSize": 200,
    "OrphanFileMinAge": "01:00:00"
  }
}
